{
  "name": "football-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/publish.mjs",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests e2e *.js *.json *.html README.md",
    "build:check": "vite build --outDir ../.ai/tmp/console-build --emptyOutDir"
  },
  "dependencies": {
    "tdesign-icons-vue-next": "^0.4.0",
    "tdesign-vue-next": "^1.17.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "prettier": "^3.9.10",
    "vite": "^6.0.0"
  }
}
